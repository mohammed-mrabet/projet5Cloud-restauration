{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "paiement-service",
            "startupProbe": {
              "httpGet": {"path": "/paiement-service/api/paiements", "port": 8080},
              "initialDelaySeconds": 10, "periodSeconds": 10, "timeoutSeconds": 5, "failureThreshold": 30
            },
            "livenessProbe": {
              "httpGet": {"path": "/paiement-service/api/paiements", "port": 8080},
              "initialDelaySeconds": 0, "periodSeconds": 20, "timeoutSeconds": 5, "failureThreshold": 3
            },
            "readinessProbe": {
              "httpGet": {"path": "/paiement-service/api/paiements", "port": 8080},
              "initialDelaySeconds": 0, "periodSeconds": 15, "timeoutSeconds": 5, "failureThreshold": 3
            }
          }
        ]
      }
    }
  }
}
