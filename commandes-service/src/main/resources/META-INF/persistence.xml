<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="commandesPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Référence la datasource "CommandesDS" créée par configure-mysql.cli
         (voir Dockerfile). -->
    <non-jta-data-source>java:jboss/datasources/CommandesDS</non-jta-data-source>

    <class>ma.ump.commandes.entity.Commande</class>
    <class>ma.ump.commandes.entity.LigneCommande</class>

    <properties>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
